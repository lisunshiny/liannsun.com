---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  const tags = [...new Set(posts.flatMap((p) => p.data.tags))];
  return tags.map((tag) => ({
    params: { tag },
    props: {
      tag,
      posts: posts
        .filter((p) => p.data.tags.includes(tag))
        .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()),
    },
  }));
}

const { tag, posts } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<Base title={`#${tag} — liann sun`}>
  <h1 style="margin-top: 0; margin-bottom: 2rem;">#{tag}</h1>

  <ul style="list-style: none; padding: 0; margin: 0;">
    {posts.map((post) => (
      <li style="display: flex; align-items: baseline; gap: 1.25rem; padding: 0.75rem 0; border-bottom: 1px solid var(--border);">
        <span style="color: var(--muted); font-size: 0.85rem; white-space: nowrap; flex-shrink: 0;">
          {post.data.date.toISOString().slice(0, 10)}
        </span>
        <a href={`${base}/posts/${post.id}`}>{post.data.title}</a>
      </li>
    ))}
  </ul>
</Base>
